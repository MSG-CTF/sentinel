[Unit]
Description=Publish a complete read-only Broker monitoring roster
Wants=network-online.target
After=network-online.target docker.service
[Service]
Type=oneshot
User=root
LoadCredential=fleet.json:/etc/sentinel-broker-fleet/publisher.json
ExecStart=/usr/bin/python3 /opt/sentinel-broker-fleet/report_broker_fleet.py
StateDirectory=sentinel-broker-fleet
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TimeoutStartSec=50
MemoryMax=128M
CPUQuota=15%
