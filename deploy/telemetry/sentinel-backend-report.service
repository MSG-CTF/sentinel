[Unit]
Description=Sentinel backend container and host resource heartbeat
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
LoadCredential=reporter.json:/etc/sentinel-telemetry/backend-reporter.json
ExecStart=/usr/bin/python3 /opt/sentinel-telemetry/report_backend.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
TimeoutStartSec=25
MemoryMax=96M
CPUQuota=10%
