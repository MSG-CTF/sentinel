{
  "AllowedHosts": "*",
  "platform_monitor": {
    "poll_interval_seconds": 15,
    "timeout_seconds": 4,
    "failure_threshold": 3,
    "recovery_threshold": 2,
    "event_file": "data/events.jsonl"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
